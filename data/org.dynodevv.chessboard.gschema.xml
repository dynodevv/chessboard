<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="chessboard">
  <schema id="org.dynodevv.chessboard" path="/org/dynodevv/chessboard/">
    <key name="window-width" type="i">
      <default>450</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="last-email" type="s">
      <default>''</default>
      <summary>Last signed-in email address</summary>
    </key>
    <key name="logging-enabled" type="b">
      <default>false</default>
      <summary>Enable logging of pawns-cli output</summary>
    </key>
  </schema>
</schemalist>
